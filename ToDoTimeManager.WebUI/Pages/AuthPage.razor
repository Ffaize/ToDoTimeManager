@using ToDoTimeManager.WebUI.Components.PageComponents.AuthPage.Forms
@using ToDoTimeManager.WebUI.Components.Shared
@using ToDoTimeManager.WebUI.Models.Enums
@using ToDoTimeManager.WebUI.Models.Models
@layout AuthLayout
@inherits BaseComponent

@page "/auth"
@GetPageTitle(nameof(AuthPage))

<div class="auth-page" @onkeydown="OnKeyDown">
    <div class="auth-page_culture-selector_container">
        <CultureSelector AdditionalCssClass="auth-page__culture-selector" />
    </div>

    <div class="auth-page__forms">
        @if (_exitingState.HasValue) {
            <div class="auth-form-slide @_exitingClass">
                <div class="auth-page__form">
                    <div class="form-wrap">
                        @GetFormSlide(_exitingState.Value)
                    </div>
                </div>

            </div>
        }
        <div class="auth-form-slide @_activeClass">
            <div class="auth-page__form">
                <div class="form-wrap">
                    @GetFormSlide(_activeState)
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginForm? _loginFormRef;
    private RegisterForm? _registerFormRef;
    private TwoFaForm? _twoFaFormRef;
    private ForgotPasswordForm? _forgotPasswordFormRef;
    private ResetPasswordForm? _resetPasswordFormRef;

    private RenderFragment GetFormSlide(AuthPageCurrentState state) => state switch
    {
        AuthPageCurrentState.Registration => RegistrationSlide,
        AuthPageCurrentState.TwoFA => TwoFaSlide,
        AuthPageCurrentState.ForgotPassword => ForgotPasswordSlide,
        AuthPageCurrentState.ResetPassword => ResetPasswordSlide,
        _ => LoginSlide
    };

    private RenderFragment LoginSlide =>
        @<LoginForm @ref="_loginFormRef" GoTo="@GoTo" AuthInfoChanged="@AuthInfoChanged" OnGoToForgotPassword="@SetForgotPasswordInitialEmail"/>;

    private RenderFragment RegistrationSlide =>
        @<RegisterForm @ref="_registerFormRef" GoTo="@GoTo" AuthInfoChanged="@AuthInfoChanged"/>;

    private RenderFragment TwoFaSlide =>
        @<TwoFaForm @ref="_twoFaFormRef" GoTo="@GoTo" SessionState="@_session" User="@_user"/>;

    private RenderFragment ForgotPasswordSlide =>
        @<ForgotPasswordForm @ref="_forgotPasswordFormRef" GoTo="@GoTo" PasswordResetInfoChanged="@PasswordResetInfoChanged" InitialEmail="@_forgotPasswordInitialEmail"/>;

    private RenderFragment ResetPasswordSlide =>
        @<ResetPasswordForm @ref="_resetPasswordFormRef" GoTo="@GoTo" SessionState="@_passwordResetSession"/>;

}
