@using ToDoTimeManager.WebUI.Components.Modals
@using ToDoTimeManager.WebUI.Components.Shared
@using ToDoTimeManager.WebUI.Components.Shared.Layouts.Helpers
@inherits LayoutComponentBase
<AuthorizeView>
    <Authorized>
        <ToastBox/>
        <ModalContainer/>
        <div class="page">
            <Scene UseEmbers="true" UsePattern="true" UseShadow="false"/>
            <NavMenu/>

            <main>
                <article class="content px-4">
                    <div class="page-container">
                        @Body
                    </div>
                </article>
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin/>
    </NotAuthorized>
</AuthorizeView>
