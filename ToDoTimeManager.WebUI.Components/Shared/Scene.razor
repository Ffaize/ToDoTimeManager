@using Microsoft.JSInterop
<div class="scene" >
    @if (UsePattern)
    {
        <div class="pattern">
        </div>
    }
    @if (UseEmbers)
    {
        <div class="embers" id="embers">
        </div>
    }
</div>

@if (UseShadow) {
    <style>
        .scene:before {
            background: radial-gradient(ellipse 60% 40% at 50% 60%, rgba(255, 106, 43, 0.12), transparent 70%), radial-gradient(ellipse 80% 50% at 50% 100%, rgba(255, 106, 43, 0.08), transparent 70%);
        }
    </style>
}

@code {
    [Inject] private IJSRuntime JSRuntime { get; set; } = null!;
    [Parameter] public bool UsePattern { get; set; } = true;
    [Parameter] public bool UseEmbers { get; set; } = true;
    [Parameter] public bool UseShadow { get; set; } = true;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && UseEmbers)
        {
            _ = JSRuntime.InvokeVoidAsync("initializeEmbers");
        }
    }

}
