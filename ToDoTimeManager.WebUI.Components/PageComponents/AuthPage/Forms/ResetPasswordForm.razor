@using ToDoTimeManager.WebUI.Models.Enums.Button
@using ToDoTimeManager.WebUI.Models.Enums.Input
@using ToDoTimeManager.WebUI.Utils
@inherits BaseComponent

<div>
    <h1 class="form-title">@Localizer["ResetPassword_Title"]</h1>
    <p class="form-sub">
        <span>@Localizer["We sent a 6-digit ember code to"]</span>
        <strong>@SessionState?.MaskedEmail</strong>
        <span>@Localizer["Drop it in below to seal the session."]</span>
    </p>
</div>

<div class="otp-row with-dash" id="otp-inputs-reset">
    <input class="otp-cell @GetIsFilledCssClass(0)" type="text" maxlength="1" autocomplete="off" value="@OtpValues[0]" @oninput="e => HandleInput(e, 1)">
    <input class="otp-cell @GetIsFilledCssClass(1)" type="text" maxlength="1" autocomplete="off" value="@OtpValues[1]" @oninput="e => HandleInput(e, 2)">
    <input class="otp-cell @GetIsFilledCssClass(2)" type="text" maxlength="1" autocomplete="off" value="@OtpValues[2]" @oninput="e => HandleInput(e, 3)">
    <span class="otp-dash">
        <span>—</span>
    </span>
    <input class="otp-cell @GetIsFilledCssClass(3)" type="text" maxlength="1" autocomplete="off" value="@OtpValues[3]" @oninput="e => HandleInput(e, 4)">
    <input class="otp-cell @GetIsFilledCssClass(4)" type="text" maxlength="1" autocomplete="off" value="@OtpValues[4]" @oninput="e => HandleInput(e, 5)">
    <input class="otp-cell @GetIsFilledCssClass(5)" type="text" maxlength="1" autocomplete="off" value="@OtpValues[5]" @oninput="e => HandleInput(e, 6)">
</div>

<div class="meta-row">
    <span class="timer">
        <span>@Localizer["CODE EXPIRES IN"] </span>
        <strong>@FormattedTime</strong>
    </span>
</div>

<div class="auth-field">
    <label class="field-label">@Localizer["ResetPassword_NewPasswordLabel"]</label>
    <Input Placeholder="xxxxxx"
        Style="@InputStyle.Default"
        Type="password"
        @bind-Value="NewPassword"
        @bind-IsValid="IsNewPasswordValid"
        IconPosition="InputIconPosition.Left"
        IsPassword="true"
        Disabled="@IsLoading"
        UseValidation="true"
        ValidationFunc="StringValidationHelper.PasswordValidation">
        <Icon>
            <LockIcon IconSize="16" />
        </Icon>
    </Input>
</div>

<div class="auth-field">
    <label class="field-label">@Localizer["ResetPassword_ConfirmPasswordLabel"]</label>
    <Input Placeholder="xxxxxx"
        Style="@InputStyle.Default"
        Type="password"
        @bind-Value="ConfirmPassword"
        @bind-IsValid="IsConfirmPasswordValid"
        IconPosition="InputIconPosition.Left"
        IsPassword="true"
        Disabled="@IsLoading"
        UseValidation="true"
        ValidationFunc="@(v => StringValidationHelper.ConfirmPasswordValidation(v, NewPassword))">
        <Icon>
            <LockIcon IconSize="16" />
        </Icon>
    </Input>
</div>

<Button Disabled="@IsButtonDisabled"
    OnClick="@OnResetClicked"
    IsLoading="@IsLoading"
    UseLoading="true"
    Style="@ButtonStyle.Primary"
    IconPosition="ButtonIconPosition.Right"
    Text="@Localizer["ResetPassword_Submit"]">
    <Icon>
        <ArrowRightIcon IconSize="14" />
    </Icon>
</Button>

<div class="helper-row">
    <a @onclick="OnUseDifferentEmailClicked" @onclick:preventDefault>
        <span>@Localizer["ResetPassword_UseDifferentEmail"]</span>
    </a>
</div>
