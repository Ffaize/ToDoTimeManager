@using ToDoTimeManager.WebUI.Models.Enums.Button
@using ToDoTimeManager.WebUI.Models.Enums.Input
@using ToDoTimeManager.WebUI.Utils
@inherits BaseComponent

<div>
    <h1 class="form-title">@Localizer["ForgotPassword_Title"]</h1>
    <p class="form-sub">@Localizer["ForgotPassword_Subtitle"]</p>
</div>

<div class="auth-field">
    <label class="field-label">@Localizer["ForgotPassword_EmailLabel"]</label>
    <Input Placeholder="email@email.com"
           Style="@InputStyle.Default"
           Type="email"
           @bind-Value="Email"
           @bind-IsValid="IsEmailValid"
           IconPosition="InputIconPosition.Left"
           Disabled="@IsLoading"
           UseValidation="true"
           ValidationFunc="StringValidationHelper.EmailValidation">
        <Icon>
            <EmailIcon IconSize="16" />
        </Icon>
    </Input>
</div>

<div class="sign-in-services-container">
    <Button OnClick="@OnBackToLoginClicked"
            UseLoading="false"
            Style="@ButtonStyle.Secondary"
            IconPosition="ButtonIconPosition.Left"
            Text="@Localizer["ForgotPassword_BackToLogin"]">
        <Icon>
            <ArrowLeftIcon IconSize="14" />
        </Icon>
    </Button>

    <Button Disabled="@IsButtonDisabled"
        OnClick="@OnSendResetCodeClicked"
        IsLoading="@IsLoading"
        UseLoading="true"
        Style="@ButtonStyle.Primary"
        IconPosition="ButtonIconPosition.Right"
        Text="@Localizer["ForgotPassword_Submit"]">
        <Icon>
            <ArrowRightIcon IconSize="14" />
        </Icon>
    </Button>
</div>
