@inherits BaseComponent

<div class="file-manager">
    <div class="file-manager__header">
        <h2 class="file-manager__title">@Localizer["Files"]</h2>
        <label class="btn btn-primary @(_uploading || IsLoading ? "disabled" : "")"
               for="fileManagerInput"
               role="button">
            @if (_uploading)
            {
                <span class="file-manager__spinner"></span>
            }
            @Localizer["Upload File"]
        </label>
        <InputFile id="fileManagerInput"
                   OnChange="HandleFileSelectedAsync"
                   accept="image/*,video/*"
                   style="display:none;" />
    </div>

    @if (IsLoading)
    {
        <div class="file-manager__grid">
            @for (var i = 0; i < 4; i++)
            {
                <div class="file-manager__item skeleton-loading"></div>
            }
        </div>
    }
    else if (_files.Count == 0)
    {
        <p class="file-manager__empty">@Localizer["No files uploaded yet."]</p>
    }
    else
    {
        <div class="file-manager__grid">
            @foreach (var (blobName, sasUrl) in _files)
            {
                <div class="file-manager__item">
                    @if (IsVideoFile(blobName))
                    {
                        <video controls src="@sasUrl" class="file-manager__media"></video>
                    }
                    else
                    {
                        <img src="@sasUrl" alt="@GetDisplayName(blobName)" class="file-manager__media" />
                    }
                    <span class="file-manager__name" title="@GetDisplayName(blobName)">
                        @GetDisplayName(blobName)
                    </span>
                </div>
            }
        </div>
    }
</div>
